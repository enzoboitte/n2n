{
  "id": "rest-endpoint",
  "name": "API REST",
  "description": "Expose une route HTTP sur un port choisi (≠ port API n2n). Plusieurs nœuds rest-endpoint sur le même port = une vraie API REST. Le path supporte les params dynamiques (:id) injectés dans request.params. Deux modes : « immediate » répond instantanément avec le body templated et lance le graphe en arrière-plan ; « deferred » garde la connexion ouverte jusqu'à ce qu'un nœud rest-end (ou un timeout) ferme la réponse — utilise rest-send pour streamer des chunks entre-temps. Géré par le runtime.",
  "version": "0.3.0",
  "color": "#f59e0b",
  "entry": "module.py",
  "configurable": true,
  "inputs": [],
  "outputs": [
    { "name": "method", "label": "Méthode", "type": "string" },
    { "name": "body", "label": "Body brut", "type": "string" },
    { "name": "json", "label": "JSON parsé", "type": "any" },
    { "name": "query", "label": "Query params", "type": "any" },
    { "name": "params", "label": "Path params (:id, …)", "type": "any" },
    { "name": "headers", "label": "Headers", "type": "any" },
    { "name": "path", "label": "Path matché", "type": "string" },
    { "name": "connectionId", "label": "ID unique de cette requête", "type": "string" },
    { "name": "client", "label": "Client {ip, userAgent}", "type": "any" }
  ],
  "params": [
    {
      "name": "port",
      "label": "Port d'écoute",
      "type": "string",
      "default": "8080"
    },
    {
      "name": "hostname",
      "label": "Hostname / interface (0.0.0.0 = toutes)",
      "type": "string",
      "default": "0.0.0.0"
    },
    {
      "name": "method",
      "label": "Méthode HTTP",
      "type": "select",
      "options": ["ANY", "GET", "POST", "PUT", "DELETE", "PATCH", "HEAD"],
      "default": "GET"
    },
    {
      "name": "path",
      "label": "Path (supports :param, ex. /users/:id)",
      "type": "string",
      "default": "/"
    },
    {
      "name": "mode",
      "label": "Mode de réponse",
      "type": "select",
      "options": ["deferred", "immediate"],
      "default": "deferred"
    },
    {
      "name": "timeout_ms",
      "label": "Timeout deferred (ms, 0 = défaut 30000)",
      "type": "string",
      "default": "30000",
      "showIf": { "mode": ["deferred"] }
    },
    {
      "name": "response_status",
      "label": "Status HTTP de la réponse (templated)",
      "type": "string",
      "default": "200",
      "showIf": { "mode": ["immediate"] }
    },
    {
      "name": "response_content_type",
      "label": "Content-Type (ex. application/json, text/html, text/plain, text/csv, application/xml)",
      "type": "string",
      "default": "application/json",
      "showIf": { "mode": ["immediate"] }
    },
    {
      "name": "response_body",
      "label": "Body de la réponse (supports {request.body}, {request.params.id}, {request.json.foo}, …)",
      "type": "text",
      "default": "{\"ok\":true}",
      "showIf": { "mode": ["immediate"] }
    },
    {
      "name": "response_headers",
      "label": "Headers additionnels (clé/valeur, templated)",
      "type": "any",
      "default": {},
      "showIf": { "mode": ["immediate"] }
    },
    {
      "name": "secret",
      "label": "Secret bearer (optionnel — Authorization, X-Api-Key, ?key=)",
      "type": "string",
      "default": ""
    }
  ]
}
