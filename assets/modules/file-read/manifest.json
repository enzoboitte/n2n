{
  "id": "file-read",
  "name": "Lire fichier",
  "description": "Lit un fichier dans le sandbox ~/.n2n/data/. Chemins relatifs rootés sous ce dossier ; chemins absolus autorisés seulement s'ils restent sous $HOME. Renvoie content=null + exists=false si le fichier n'existe pas. Géré par le runtime.",
  "version": "0.1.0",
  "color": "#22c55e",
  "entry": "module.py",
  "configurable": true,
  "inputs": [],
  "outputs": [
    { "name": "content", "label": "Contenu", "type": "string" },
    { "name": "exists", "label": "Existe ?", "type": "boolean" },
    { "name": "path", "label": "Chemin absolu", "type": "string" },
    { "name": "size", "label": "Octets", "type": "number" }
  ],
  "params": [
    {
      "name": "path",
      "label": "Chemin (relatif → ~/.n2n/data/)",
      "type": "string",
      "default": ""
    },
    {
      "name": "encoding",
      "label": "Encodage",
      "type": "select",
      "options": ["utf8", "base64"],
      "default": "utf8"
    }
  ]
}
